# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vyomai?retryWrites=true&w=majority

# Administrative Credentials for Admin Panel (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_SECRET_KEY=your_secret_key_here

# Email Notifications (Brevo / Sendinblue or SMTP)
NOTIFICATION_EMAIL=vyomaisolutions@gmail.com

# Brevo REST API (Recommended - avoids port blocking & DNS issues)
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=vyomaisolutions@gmail.com
BREVO_SENDER_NAME="VyomAI Solutions"

# SMTP Relay Fallback (Optional)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-or-gmail-user
SMTP_PASS=your-smtp-password-or-app-pass

