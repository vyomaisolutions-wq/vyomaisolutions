# ==========================================
# Dependencies
# ==========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# Next.js Build Outputs & Caches
# ==========================================
/.next/
/out/
/build
/dist

# ==========================================
# TypeScript & Testing Artifacts
# ==========================================
/coverage
*.tsbuildinfo
next-env.d.ts

# ==========================================
# Environment Variables & Private Secrets
# ==========================================
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ==========================================
# Debug & Runtime Logs
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ==========================================
# IDE & Editor Configurations
# ==========================================
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Security Keys & SSL Certificates
# ==========================================
*.pem
*.key
*.cert
*.crt

# ==========================================
# Vercel Deployment Metadata
# ==========================================
.vercel

# ==========================================
# Uploaded User Media (Preserves Directory)
# ==========================================
/public/uploads/*
!/public/uploads/.gitkeep
